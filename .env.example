# Model chạy trên máy qua llama.cpp llama-server (xem docs/chay-model-local.md)
THAMDINH_MODEL=qwen3.5
THAMDINH_LOCAL_URL=http://127.0.0.1:8080/v1
# Phải khớp tham số -c khi chạy llama-server
THAMDINH_NGU_CANH=49152
# Bật chế độ suy luận (thinking) của Qwen3.5: chậm hơn nhiều trên CPU
THAMDINH_SUY_LUAN=false
# Token tối đa model viết mỗi lần gọi, tính cả phần suy luận (nâng lên khi bật suy luận)
THAMDINH_TOI_DA_TOKEN=4096
THAMDINH_DATA_DIR=data
# Chế độ truy xuất: ngân sách token văn bản mỗi Mục, và máy chủ embedding bge-m3 (llama-server --embedding)
THAMDINH_NGAN_SACH_TRUY_XUAT=16000
THAMDINH_EMBEDDING_URL=http://127.0.0.1:8081/v1
THAMDINH_EMBEDDING_MODEL=bge-m3
# OCR cho trang có lớp text kém: model VietOCR (vgg_transformer | vgg_seq2seq) và thư mục chứa model
THAMDINH_OCR_MODEL=vgg_transformer
THAMDINH_OCR_MODEL_DIR=models/vietocr
# Tên Người thẩm định ghi vào Kết quả đã duyệt (trống thì nhập trên trang Kết quả)
THAMDINH_NGUOI_DUYET=
